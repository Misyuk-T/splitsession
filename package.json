{
  "name": "splitsession",
  "version": "0.1.7",
  "private": true,
  "description": "Same site, separate logins: several accounts of one site open side by side in one Chrome profile.",
  "license": "MIT",
  "author": "Taras Misiuk",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:lite": "FACET_EDITION=lite wxt",
    "build": "wxt build",
    "build:full": "wxt build",
    "build:lite": "FACET_EDITION=lite wxt build && node scripts/check-lite.mjs",
    "zip": "wxt zip",
    "zip:full": "wxt zip",
    "zip:lite": "FACET_EDITION=lite wxt zip && node scripts/check-lite.mjs",
    "check:lite": "node scripts/check-lite.mjs",
    "store:assets": "pnpm build:lite && node scripts/store-assets.mjs",
    "readme:media": "pnpm build:lite && node scripts/readme-media.mjs",
    "agent:media": "pnpm build:full && node bridge/build.mjs && node scripts/agent-media.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p bridge",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "keygen": "node scripts/keygen.mjs",
    "postinstall": "wxt prepare",
    "e2e": "wxt build && pnpm build:lite && node bridge/build.mjs && playwright test -c e2e/playwright.config.ts",
    "e2e:lite": "pnpm build:lite && playwright test -c e2e/playwright.config.ts lite.spec",
    "e2e:only": "playwright test -c e2e/playwright.config.ts",
    "stand": "node test-server/server.mjs",
    "bridge:build": "node bridge/build.mjs",
    "bridge:install": "node scripts/bridge-install.mjs",
    "bridge:uninstall": "node scripts/bridge-install.mjs --uninstall"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "preact": "^11.0.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4",
    "zod": "^4.6.5"
  }
}
