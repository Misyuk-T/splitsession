  "keywords": [
    "mcp",
    "chrome",
    "native-messaging",
    "splitsession",
    "containers"
  ],
  "license": "MIT",
  "author": "Taras Misiuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misyuk-T/splitsession.git",
    "directory": "bridge"
  },
  "homepage": "https://github.com/Misyuk-T/splitsession/blob/main/docs/agents.md",
  "bugs": {
    "url": "https://github.com/Misyuk-T/splitsession/issues"
  },
  "type": "module",
  "bin": {
    "splitsession-bridge": "dist/splitsession-bridge.mjs"
  },
  "files": [
    "dist/splitsession-bridge.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
